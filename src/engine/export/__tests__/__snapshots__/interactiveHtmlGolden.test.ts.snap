"
@font-face { font-family: "Kova Icons"; }
.slide-frame { color: rgb(34, 34, 34); }
.sl-step-item--pending { opacity: 0; }
html, body {
  margin: 0 !important;
  padding: 0 !important;
  width: 100% !important;
  height: 100% !important;
  overflow: hidden !important;
  background: #102030 !important;
}
.kova-deck {
  position: fixed !important;
  inset: 0 !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  background: #102030 !important;
  cursor: default;
}
.kova-deck-slide {
  display: none !important;
}
.kova-deck-slide.is-active {
  display: block !important;
}
.kova-deck-frame {
  width: 960px !important;
  height: 540px !important;
  overflow: hidden !important;
  position: relative !important;
  transform-origin: center center !important;
}
.kova-deck-scale {
  width: 960px !important;
  height: 540px !important;
}
.kova-chrome {
  position: fixed !important;
  right: 16px !important;
  bottom: 12px !important;
  z-index: 10 !important;
  color: #fff !important;
  font: 13px/1.2 -apple-system, system-ui, sans-serif !important;
  opacity: 0.75 !important;
  pointer-events: none !important;
  text-shadow: 0 1px 2px rgba(0,0,0,0.6);
  user-select: none !important;
}
.kova-chrome kbd {
  font: inherit !important;
  opacity: 0.85 !important;
}
@media print {
  html, body {
    overflow: visible !important;
    height: auto !important;
    background: #fff !important;
  }
  .kova-chrome { display: none !important; }
  .kova-deck {
    position: static !important;
    display: block !important;
    background: #fff !important;
  }
  .kova-deck-slide {
    display: block !important;
    break-after: page;
    page-break-after: always;
    margin: 0 auto !important;
  }
  .kova-deck-slide:last-child {
    break-after: avoid;
    page-break-after: avoid;
  }
  .kova-deck-frame {
    transform: none !important;
  }
}
"
`;

